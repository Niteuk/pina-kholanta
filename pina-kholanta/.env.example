# Copie ce fichier en ".env" (ou renseigne ces variables dans le panneau de ton hébergeur)

# Token du bot (Discord Developer Portal > Bot > Reset Token). Ne le partage jamais.
DISCORD_TOKEN=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant, mode développeur activé)
GUILD_ID=

# --- Optionnel : réglages (valeurs par défaut entre parenthèses) ---
# Temps minimum en voc pour être éligible, en minutes (60)
# MIN_PRESENCE_MINUTES=60
# Délai avec le vocal vide avant de clore la session, en minutes (5)
# EMPTY_GRACE_MINUTES=5
# Durée du vote, en minutes (15)
# VOTE_DURATION_MINUTES=15
# Dossier où est stockée la base de données (./data)
# DATA_DIR=./data
